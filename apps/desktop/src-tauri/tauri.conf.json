{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Look",
  "mainBinaryName": "omnilook",
  "version": "0.2.0",
  "identifier": "app.omnilook.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://look.localhost look:",
        "media-src": "http://look.localhost look:",
        "frame-src": "http://look.localhost look:",
        "font-src": "'self' data: http://look.localhost look:",
        "connect-src": "'self' ipc: http://ipc.localhost http://look.localhost look: data: blob:"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Omni Look Contributors",
    "copyright": "Copyright (c) 2026 Omni Look Contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Press Ctrl+Space in Explorer to preview files",
    "longDescription": "Omni Look previews files from Explorer and the desktop with a key press: text and code with highlighting, images, archives, PDF, audio, video and Office documents.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../node_modules/occt-wasm/dist/occt-wasm.wasm": "occt/occt-wasm.wasm",
      "../../../licenses/OCCT-LGPL-2.1.txt": "occt/LICENSE-LGPL-2.1.txt",
      "../../../licenses/README.md": "occt/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "section": "utils"
      },
      "rpm": {
        "recommends": [
          "gstreamer1-plugins-good"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNzBGRTAzM0QyN0ExNTQKUldSVW9TYzlBLzV3NFVjV3J3UEhNRDVFZXBHQ24waWwwSTdOMC84eHdKSFNVMnRkR1JLUE9JTDQK",
      "endpoints": [
        "https://github.com/VoidDel/OmniLook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
