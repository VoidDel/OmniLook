{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Look",
  "mainBinaryName": "omnilook",
  "version": "0.1.0",
  "identifier": "app.omnilook.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://look.localhost",
        "media-src": "http://look.localhost",
        "frame-src": "http://look.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://look.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Omni Look Contributors",
    "copyright": "Copyright (c) 2026 Omni Look Contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Press Ctrl+Space in Explorer to preview files",
    "longDescription": "Omni Look previews files from Explorer and the desktop with a key press: text and code with highlighting, images, archives, PDF, audio, video and Office documents.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
